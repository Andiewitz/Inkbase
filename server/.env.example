# Server environment variables.
# Copy to .env and fill in for local dev. Railway provides these via variables.

# App mode — set to "production" on Railway (enables Postgres, Secure cookies,
# JWT_SECRET enforcement). Blank/absent = local dev with SQLite + memory store.
APP_ENV=

# Port the server listens on. Railway injects this automatically.
PORT=8080

# Postgres connection string (required when APP_ENV=production).
DATABASE_URL=

# HMAC signing secret for JWTs (required when APP_ENV=production).
JWT_SECRET=

# Set to "true" when the server sits behind a reverse proxy (Nginx / Railway
# edge). Without this, the rate limiter sees the proxy IP for all clients
# instead of the real client IP.
TRUST_PROXY=true
